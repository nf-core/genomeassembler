includeConfig 'phasing_dorado.config'

process {
    // Routing-only Medaka stub; the GPU runtime is not under test.
    withName: MEDAKA {
        container = 'community.wave.seqera.io/library/htslib_samtools:1.24--d697cfb9dce007cd'
        beforeScript = 'mkdir -p mock-bin; printf "#!/bin/sh\\necho medaka-routing-stub\\n" > mock-bin/medaka; chmod +x mock-bin/medaka; export PATH="$PWD/mock-bin:$PATH"'
    }
}
