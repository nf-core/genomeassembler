includeConfig 'phasing_merqury.config'

process {
    withName: FASTPLONG_ONT {
        afterScript = 'for report in *.json; do echo \'{"summary":{"after_filtering":{"read_mean_length":8}}}\' > "$report"; done'
    }
    // Routing-only stubs: avoid the GPU Dorado image and mock its version command.
    // Alignment/polishing output stubs still come from the production modules.
    withName: '.*POLISH_DORADO:(ALIGN|POLISH)' {
        container = 'community.wave.seqera.io/library/htslib_samtools:1.24--d697cfb9dce007cd'
        beforeScript = 'mkdir -p mock-bin; printf "#!/bin/sh\\necho dorado-routing-stub\\n" > mock-bin/dorado; chmod +x mock-bin/dorado; export PATH="$PWD/mock-bin:$PATH"'
    }
    withName: RAGTAG_SCAFFOLD {
        // A null/wrong polished assembly must fail even though RagTag is stubbed.
        afterScript = { "test -f assembly/${meta.haplotype ? meta.id + '_' + meta.haplotype : meta.id}_dorado_polished.fa.gz" }
    }
}
