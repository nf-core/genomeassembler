// Stub routing needs only tiny resources on CI runners.
process.resourceLimits = [cpus: 1, memory: '2 GB', time: '10 min']

params.omit_haplotypes = null
params.include_unphased = false
params.hic_input_swap = null
params.hybrid_phasing = false
process {
    withName: HIFIASM_HIC {
        afterScript = {
            """
            ${params.omit_haplotypes == 'both' ? 'rm -f *.hap1.p_ctg.gfa *.hap2.p_ctg.gfa' : params.omit_haplotypes ? "rm -f *.${params.omit_haplotypes}.p_ctg.gfa" : ':'}
            test '${ul_reads ? "present" : "absent"}' = '${meta.strategy == "hybrid" ? "present" : "absent"}' || {
                echo 'ONT input routing mismatch' >&2
                exit 1
            }
            test "\$(head -n 1 '${hic_read1}')" = '@${meta.id}:R1' && \
            test "\$(head -n 1 '${hic_read2}')" = '@${meta.id}:R2' || {
                echo 'Hi-C input identity mismatch' >&2
                exit 1
            }
            """
        }
    }
}
