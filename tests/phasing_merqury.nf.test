nextflow_workflow {
    name "Phased assemblies retain source-specific Merqury databases"
    script "../workflows/genomeassembler.nf"
    workflow "GENOMEASSEMBLER"
    config "tests/conf/phasing_merqury.config"
    tag "pipeline"
    tag "hic_phasing"

    test("Two samples produce Merqury results for all four haplotypes") {
        options "-stub-run"
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of('sampleA', 'sampleB').map { id ->
                    [meta: [
                        id: id, strategy: 'single', assembler_hifi: 'hifiasm',
                        hifiasm_hic_phasing: true, scaffold_hic: false,
                        hifireads: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/HiFi-Col-0_test_data.fastq.gz'),
                        phasing_reads: [f: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz'), r: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz')],
                        shortread_F: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz'),
                        shortread_R: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz'),
                        shortread_trim: true, paired: true, hic_trim: false,
                        qc_reads: 'hifi', jellyfish: false, meryl_k: 21,
                        quast: false, busco: false, merqury: true,
                        use_short_reads: true, lift_annotations: false
                    ]]
                }
                """
            }
        }
        then {
            assert workflow.success
            def reports = []
            new File("$outputDir").eachFileRecurse { f ->
                if (f.name.endsWith('.completeness.stats')) reports << f
            }
            assert reports*.name.sort() == ['sampleA_hap1_assembly.completeness.stats', 'sampleA_hap2_assembly.completeness.stats', 'sampleB_hap1_assembly.completeness.stats', 'sampleB_hap2_assembly.completeness.stats']
            assert reports.every { it.text.trim() == it.name.split('_hap')[0] }
            def samples = workflow.out._assemblies.collect { it.meta }
            assert samples.collect { [it.id, it.haplotype] }.sort { it.toString() } == [['sampleA', 'hap1'], ['sampleA', 'hap2'], ['sampleB', 'hap1'], ['sampleB', 'hap2']]
            assert samples.every { !it.source_sample }
            assert snapshot(reports.collect { [it.name, it.text.trim()] }.sort { it[0] }).match()
        }
    }
    test("Untrimmed short reads produce Merqury results for all four haplotypes") {
        options "-stub-run"
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of('sampleA', 'sampleB').map { id ->
                    [meta: [
                        id: id, strategy: 'single', assembler_hifi: 'hifiasm',
                        hifiasm_hic_phasing: true, scaffold_hic: false,
                        hifireads: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/HiFi-Col-0_test_data.fastq.gz'),
                        phasing_reads: [f: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz'), r: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz')],
                        shortread_F: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz'),
                        shortread_R: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz'),
                        shortread_trim: false, paired: true, hic_trim: false,
                        qc_reads: 'hifi', jellyfish: false, meryl_k: 21,
                        quast: false, busco: false, merqury: true,
                        use_short_reads: true, lift_annotations: false
                    ]]
                }
                """
            }
        }
        then {
            assert workflow.success
            def reports = []
            new File("$outputDir").eachFileRecurse { f ->
                if (f.name.endsWith('.completeness.stats')) reports << f
            }
            assert reports*.name.sort() == ['sampleA_hap1_assembly.completeness.stats', 'sampleA_hap2_assembly.completeness.stats', 'sampleB_hap1_assembly.completeness.stats', 'sampleB_hap2_assembly.completeness.stats']
            assert reports.every { it.text.trim() == it.name.split('_hap')[0] }
            def samples = workflow.out._assemblies.collect { it.meta }
            assert samples.collect { [it.id, it.haplotype] }.sort { it.toString() } == [['sampleA', 'hap1'], ['sampleA', 'hap2'], ['sampleB', 'hap1'], ['sampleB', 'hap2']]
            assert samples.every { !it.source_sample }
            assert snapshot(reports.collect { [it.name, it.text.trim()] }.sort { it[0] }).match()
        }
    }
    test("Phased and unphased samples retain their own QC databases and filenames") {
        tag "phasing_mixed"
        options "-stub-run"
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of('sampleA', 'sampleB', 'unphased').map { id ->
                    [meta: [
                        id: id, strategy: 'single', assembler_hifi: 'hifiasm',
                        hifiasm_hic_phasing: id != 'unphased', scaffold_hic: false,
                        hifireads: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/HiFi-Col-0_test_data.fastq.gz'),
                        phasing_reads: [f: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz'), r: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz')],
                        shortread_F: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz'),
                        shortread_R: file(params.pipelines_testdata_base_path + '/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz'),
                        shortread_trim: true, paired: true, hic_trim: false,
                        qc_reads: 'hifi', jellyfish: false, meryl_k: 21,
                        quast: false, busco: false, merqury: true,
                        use_short_reads: true, lift_annotations: false
                    ]]
                }
                """
            }
        }
        then {
            assert workflow.success
            def reports = []
            new File("$outputDir").eachFileRecurse { f ->
                if (f.name.endsWith('.completeness.stats')) reports << f
            }
            assert reports*.name.sort() == ['sampleA_hap1_assembly.completeness.stats', 'sampleA_hap2_assembly.completeness.stats', 'sampleB_hap1_assembly.completeness.stats', 'sampleB_hap2_assembly.completeness.stats', 'unphased_assembly.completeness.stats']
            assert reports.every { it.text.trim() == (it.name.startsWith('unphased_') ? 'unphased' : it.name.split('_hap')[0]) }
            def samples = workflow.out._assemblies.collect { it.meta }
            assert samples.collect { [it.id, it.haplotype] }.sort { it.toString() } == [['sampleA', 'hap1'], ['sampleA', 'hap2'], ['sampleB', 'hap1'], ['sampleB', 'hap2'], ['unphased', null]]
            assert samples.every { !it.source_sample }
            assert path(samples.find { it.id == 'unphased' }.assembly).getFileName().toString() == 'unphased.fa.gz'
            assert snapshot(reports.collect { [it.name, it.text.trim()] }.sort { it[0] }).match()
        }
    }
}
