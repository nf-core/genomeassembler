nextflow_workflow {
    name "Phased assembly downstream integration"
    script "../workflows/genomeassembler.nf"
    workflow "GENOMEASSEMBLER"
    config "tests/conf/phasing_merqury.config"
    tag "pipeline"
    tag "hic_phasing"

    test("Both haplotypes retain polishing, scaffold and QC results without cross-joins") {
        options "-stub-run"
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of('sampleA', 'sampleB').map { id ->
                    [meta: [
                        id: id, strategy: 'single', assembler_hifi: 'hifiasm',
                        hifiasm_hic_phasing: true, scaffold_hic: true, scaffold_ragtag: true, scaffold: true,
                        hic_aligner: 'minimap2', polish: 'pilon',
                        hic_F: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz"), hic_R: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz"),
                        ref_fasta: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/Col-CEN_v1.2.Chr1_5MB-7MB.fasta.gz"), use_ref: false,
                        hifireads: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/HiFi-Col-0_test_data.fastq.gz"),
                        phasing_reads: [f: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz"), r: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz")],
                        shortread_F: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz"),
                        shortread_R: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz"),
                        shortread_trim: true, paired: true, hic_trim: true,
                        qc_reads: 'hifi', jellyfish: false, meryl_k: 21,
                        quast: true, busco: false, merqury: true,
                        use_short_reads: true, lift_annotations: false
                    ]]
                }
                """
            }
        }
        then {
            assert workflow.success
            def reports = []
            new File("$outputDir").eachFileRecurse { f ->
                if (f.name.endsWith('.completeness.stats')) reports << f
            }
            def expected = ['sampleA', 'sampleB'].collectMany { sample ->
                ['hap1', 'hap2'].collectMany { hap ->
                    ['assembly', 'pilon', 'yahs', 'ragtag'].collect { stage -> "${sample}_${hap}_${stage}.completeness.stats".toString() }
                }
            }
            assert reports*.name.sort() == expected.sort()
            assert reports.every { it.text.trim() == it.name.split('_hap')[0] }
            def samples = workflow.out.assemblies.collect { it.meta }
            assert samples*.id.sort() == ['sampleA', 'sampleB']
            assert samples.every { it.haplotypes.keySet() == ['hap1', 'hap2'] as Set }
            assert samples.every { !it.haplotype && !it.source_sample }
            assert samples.every { meta ->
                ['hap1', 'hap2'].every { hap ->
                    def result = meta.haplotype_results[hap]
                    path(result.polished.pilon).getFileName().toString() == "${meta.id}_${hap}_pilon.fa.gz" &&
                    result.scaffolds.keySet() == ['hic', 'ragtag'] as Set &&
                    result.scaffolds.every { stage, fasta -> path(fasta).getFileName().toString().startsWith("${meta.id}_${hap}_") }
                }
            }
            def manifest = new File("$outputDir/genomeqc_samplesheet/nf-core-genomeqc-in.csv").readLines()
            assert manifest.size() == 17
            assert manifest.toSet().size() == manifest.size()
            assert manifest.drop(1).every { row ->
                def columns = row.split(',')
                def sample = columns[0].split('_hap')[0]
                columns[1].contains("/${sample}/") && new File(columns[1]).exists()
            }
            def quast = []
            new File("$outputDir").eachFileRecurse { f -> if (f.parentFile.name == 'QUAST' && f.name.endsWith('.tsv')) quast << f.name }
            assert quast.toSet().size() >= 16
            assert snapshot(reports.collect { [it.name, it.text.trim()] }.sort { it[0] }).match()
        }
    }
}
