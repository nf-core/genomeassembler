    test("ONT reads are auxiliary input for phased HiFi assembly") {
        when {
            params {
                input = "https://raw.githubusercontent.com/nf-core/test-datasets/218acd6325ddcd1214e48951f3df5e3d0d2edc20/samplesheet/phasing/phasing_25.csv"
                outdir = "$outputDir"
                hifireads = null
                ontreads = null
                hic_F = null
                hic_R = null
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.success
            def meta = workflow.out.samplesheet[0].meta
            assert meta.assembler_hifi == 'hifiasm' && !meta.assembler_ont
            assert meta.hifireads && meta.ontreads && meta.phasing_reads
            assert snapshot([meta.id, meta.assembler_hifi, meta.strategy, meta.hifiasm_hic_phasing]).match()
        }
    }

