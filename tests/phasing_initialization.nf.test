nextflow_workflow {
    name "Hi-C phasing samplesheet initialization"
    script "../subworkflows/local/utils_nfcore_genomeassembler_pipeline/main.nf"
    workflow "PIPELINE_INITIALISATION"
    tag "pipeline"
    tag "phasing_initialization"

    test("hifiasm_args rejects -1 paternal.yak") {
        when {
            params {
                input = "${projectDir}/tests/data/phasing_00.csv"
                outdir = "$outputDir"
                hifireads = null
                ontreads = null
                hic_F = null
                hic_R = null
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.failed
            def message = 'trio inputs -1 and -2 are incompatible with hifiasm_hic_phasing.'
            assert (workflow.stdout + workflow.stderr).any { it.contains(message) }
            assert snapshot(message).match()
        }
    }

