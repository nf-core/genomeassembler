                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.failed
            def message = 'hifiasm_hic_phasing requires single-strategy hifiasm assembly with HiFi reads only and no supplied assembly.'
            assert (workflow.stdout + workflow.stderr).any { it.contains(message) }
            assert snapshot(message).match()
        }
    }

