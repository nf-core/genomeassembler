    test("Trimming is independent of phasing") {
        when {
            params {
                input = "https://raw.githubusercontent.com/nf-core/test-datasets/218acd6325ddcd1214e48951f3df5e3d0d2edc20/samplesheet/phasing/phasing_29.csv"
                outdir = "$outputDir"
                hifireads = null
                ontreads = null
                hic_F = null
                hic_R = null
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.success
            def meta = workflow.out.samplesheet[0].meta
            assert meta.hic_trim
            assert meta.phasing_reads.keySet() == ['f', 'r'] as Set
            assert path(meta.phasing_reads.f).getFileName().toString() == 'SRR22354810_1.sampled.fq.gz'
            assert path(meta.phasing_reads.r).getFileName().toString() == 'SRR22354810_2.sampled.fq.gz'
            assert snapshot([meta.id, meta.hic_trim, meta.phasing_reads.keySet().sort(), meta.assembler_hifi_args]).match()
        }
    }

    test("Previously derived sample IDs remain valid original sample IDs") {
        tag "phasing_output_names"
        when {
            params {
                input = "https://raw.githubusercontent.com/nf-core/test-datasets/218acd6325ddcd1214e48951f3df5e3d0d2edc20/samplesheet/phasing/phasing_original_ids.csv"
                outdir = "$outputDir"
                hifireads = null
                ontreads = null
                hic_F = null
                hic_R = null
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.samplesheet*.meta*.id.sort() == ['sample', 'sample-hap1']
            def meta = workflow.out.samplesheet.find { it.meta.id == 'sample' }.meta
            assert meta.hic_trim
            assert meta.phasing_reads.keySet() == ['f', 'r'] as Set
            assert path(meta.phasing_reads.f).getFileName().toString() == 'SRR22354810_1.sampled.fq.gz'
            assert path(meta.phasing_reads.r).getFileName().toString() == 'SRR22354810_2.sampled.fq.gz'
            assert snapshot([meta.id, meta.hic_trim, meta.phasing_reads.keySet().sort(), meta.assembler_hifi_args]).match()
        }
    }

    test("Compatible assembly phasing arguments") {
        tag "phasing_compatible"
        when {
            params {
                input = "https://raw.githubusercontent.com/nf-core/test-datasets/218acd6325ddcd1214e48951f3df5e3d0d2edc20/samplesheet/phasing/phasing_30.csv"
                outdir = "$outputDir"
                hifireads = null
                ontreads = null
                hic_F = null
                hic_R = null
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.success
            def meta = workflow.out.samplesheet[0].meta
            assert meta.hic_trim
            assert meta.phasing_reads.keySet() == ['f', 'r'] as Set
            assert path(meta.phasing_reads.f).getFileName().toString() == 'SRR22354810_1.sampled.fq.gz'
            assert path(meta.phasing_reads.r).getFileName().toString() == 'SRR22354810_2.sampled.fq.gz'
            assert snapshot([meta.id, meta.hic_trim, meta.phasing_reads.keySet().sort(), meta.assembler_hifi_args]).match()
        }
    }
    test("Auxiliary ONT reads cannot enable a second assembler") {
        tag "phasing_aux_validation"
        when {
            params {
                input = "https://raw.githubusercontent.com/nf-core/test-datasets/218acd6325ddcd1214e48951f3df5e3d0d2edc20/samplesheet/phasing/phasing_ont_assembler.csv"
                outdir = "$outputDir"
                hifireads = null
                ontreads = null
                hic_F = null
                hic_R = null
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.failed
            def message = 'hifiasm_hic_phasing requires single-strategy hifiasm assembly with HiFi reads and no supplied assembly.'
            assert (workflow.stdout + workflow.stderr).any { it.contains(message) }
            assert snapshot(message).match()
        }
    }

}
