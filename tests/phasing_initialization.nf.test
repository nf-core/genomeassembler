nextflow_workflow {
    name "Hi-C phasing samplesheet initialization"
    script "../subworkflows/local/utils_nfcore_genomeassembler_pipeline/main.nf"
    workflow "PIPELINE_INITIALISATION"
    tag "pipeline"
    tag "phasing_initialization"

    def testdata = "https://raw.githubusercontent.com/nf-core/test-datasets/218acd6325ddcd1214e48951f3df5e3d0d2edc20/samplesheet/phasing"
    def errors = [
        trio: "trio inputs -1 and -2 are incompatible with hifiasm_hic_phasing.",
        assemblyMode: "--primary and --ont are incompatible with hifiasm_hic_phasing.",
        outputCollision: "haplotype output prefixes collide with another samplesheet sample.",
        sampleIds: "Samplesheet sample IDs must be unique.",
        prerequisites: "hifiasm_hic_phasing requires single or hybrid hifiasm assembly with HiFi reads and no supplied assembly; hybrid assembly also requires ONT reads.",
        hicMates: "hifiasm_hic_phasing requires both hic_F and hic_R."
    ]
    def scenarios = [
        [name: "hifiasm_args rejects -1 paternal.yak", fixture: "phasing_00.csv", error: errors.trio],
        [name: "hifiasm_args rejects -2 maternal.yak", fixture: "phasing_01.csv", error: errors.trio],
        [name: "hifiasm_args rejects -1paternal.yak", fixture: "phasing_02.csv", error: errors.trio],
        [name: "hifiasm_args rejects -2=maternal.yak", fixture: "phasing_03.csv", error: errors.trio],
        [name: "hifiasm_args rejects --primary", fixture: "phasing_04.csv", error: errors.assemblyMode],
        [name: "hifiasm_args rejects --ont", fixture: "phasing_05.csv", error: errors.assemblyMode],
        [name: "assembler_hifi_args rejects -1 paternal.yak", fixture: "phasing_06.csv", error: errors.trio],
        [name: "assembler_hifi_args rejects -2 maternal.yak", fixture: "phasing_07.csv", error: errors.trio],
        [name: "assembler_hifi_args rejects -1paternal.yak", fixture: "phasing_08.csv", error: errors.trio],
        [name: "assembler_hifi_args rejects -2=maternal.yak", fixture: "phasing_09.csv", error: errors.trio],
        [name: "assembler_hifi_args rejects --primary", fixture: "phasing_10.csv", error: errors.assemblyMode],
        [name: "assembler_hifi_args rejects --ont", fixture: "phasing_11.csv", error: errors.assemblyMode],
        [name: "hap1 output prefix collision", fixture: "phasing_18.csv", error: errors.outputCollision],
        [name: "hap2 output prefix collision", fixture: "phasing_19.csv", error: errors.outputCollision],
        [name: "duplicate sample IDs", fixture: "phasing_20.csv", error: errors.sampleIds],
        [name: "hybrid strategy", fixture: "phasing_21.csv", mode: "hybrid"],
        [name: "scaffold strategy", fixture: "phasing_22.csv", error: errors.prerequisites],
        [name: "wrong assembler", fixture: "phasing_23.csv", error: errors.prerequisites],
        [name: "missing HiFi", fixture: "phasing_24.csv", error: errors.prerequisites],
        [name: "ONT reads are auxiliary input for phased HiFi assembly", fixture: "phasing_25.csv", mode: "auxiliary"],
        [name: "supplied assembly", fixture: "phasing_26.csv", error: errors.prerequisites],
        [name: "missing Hi-C forward", fixture: "phasing_27.csv", error: errors.hicMates],
        [name: "missing Hi-C reverse", fixture: "phasing_28.csv", error: errors.hicMates],
        [name: "Trimming is independent of phasing", fixture: "phasing_29.csv", mode: "compatible"],
        [name: "Previously derived sample IDs remain valid original sample IDs", fixture: "phasing_original_ids.csv", mode: "original_ids"],
        [name: "Compatible assembly phasing arguments", fixture: "phasing_30.csv", mode: "compatible"],
        [name: "Auxiliary ONT reads cannot enable a second assembler", fixture: "phasing_ont_assembler.csv", error: errors.prerequisites]
    ]

    scenarios.each { scenario ->
        test(scenario.name) {
            when {
                params {
                    input = "${testdata}/${scenario.fixture}"
                    outdir = "$outputDir"
                    hifireads = null
                    ontreads = scenario.mode == "hybrid" ? "https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/HiFi-Col-0_test_data.fastq.gz" : null
                    hic_F = null
                    hic_R = null
                }
                workflow {
                    """
                    input[0] = false
                    input[1] = false
                    input[2] = true
                    input[3] = []
                    input[4] = params.outdir
                    input[5] = params.input
                    input[6] = false
                    input[7] = false
                    input[8] = false
                    """
                }
            }
            then {
                if (scenario.error) {
                    assert workflow.failed
                    assert (workflow.stdout + workflow.stderr).any { it.contains(scenario.error) }
                    assert snapshot(scenario.error).match()
                }
                else {
                    assert workflow.success
                    def meta = workflow.out.samplesheet.find { it.meta.id == 'sample' }.meta
                    if (scenario.mode == 'hybrid') {
                        assert meta.strategy == 'hybrid' && meta.assembler_ont == 'hifiasm'
                        assert meta.hifireads && meta.ontreads && meta.phasing_reads
                    }
                    else if (scenario.mode == 'auxiliary') {
                        assert meta.assembler_hifi == 'hifiasm' && !meta.assembler_ont
                        assert meta.hifireads && meta.ontreads && meta.phasing_reads
                        assert snapshot([meta.id, meta.assembler_hifi, meta.strategy, meta.hifiasm_hic_phasing]).match()
                    }
                    else {
                        if (scenario.mode == 'original_ids') {
                            assert workflow.out.samplesheet*.meta*.id.sort() == ['sample', 'sample-hap1']
                        }
                        assert meta.hic_trim
                        assert meta.phasing_reads.keySet() == ['f', 'r'] as Set
                        assert path(meta.phasing_reads.f).getFileName().toString() == 'SRR22354810_1.sampled.fq.gz'
                        assert path(meta.phasing_reads.r).getFileName().toString() == 'SRR22354810_2.sampled.fq.gz'
                        assert snapshot([meta.id, meta.hic_trim, meta.phasing_reads.keySet().sort(), meta.assembler_hifi_args]).match()
                    }
                }
            }
        }
    }
}
