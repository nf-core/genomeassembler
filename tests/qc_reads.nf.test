nextflow_workflow {
    name "QC read selection during samplesheet initialization"
    script "../subworkflows/local/utils_nfcore_genomeassembler_pipeline/main.nf"
    workflow "PIPELINE_INITIALISATION"
    config "tests/conf/qc_reads.config"
    tag "pipeline"
    tag "qc_reads"

    test("Single-read samples select available reads and mixed samples retain their choice") {
        when {
            params {
                // The test profile supplies both read types; clear those defaults.
                hifireads = null
                ontreads = null
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = true
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.success
            def choices = workflow.out.samplesheet.collect { [it.meta.id, it.meta.qc_reads] }.sort { it[0] }
            assert choices == [['hifi', 'hifi'], ['mixed_hifi', 'hifi'], ['mixed_ont', 'ont'], ['ont', 'ont']]
            assert snapshot(choices).match()
        }
    }
}
