nextflow_function {
    name "Haplotype assembly identity"
    script "../subworkflows/local/assembly_haplotypes/main.nf"
    tag "pipeline"
    tag "phasing_metadata"

    test("Join keys distinguish haplotypes without inventing sample IDs") {
        function "createHaplotypeKey"
        when {
            function {
                """
                input[0] = [id: 'sample', haplotype: 'hap2']
                """
            }
        }
        then {
            assert function.success
            assert function.result == ['sample', 'hap2']
            assert snapshot(function.result).match()
        }
    }

    test("Unphased filenames retain the original sample prefix") {
        function "createHaplotypePrefix"
        when {
            function {
                """
                input[0] = [id: 'unphased']
                """
            }
        }
        then {
            assert function.success
            assert function.result == 'unphased'
            assert snapshot(function.result).match()
        }
    }
}
