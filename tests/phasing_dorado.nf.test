nextflow_workflow {
    name "Dorado haplotype polishing and scaffolding"
    script "../workflows/genomeassembler.nf"
    workflow "GENOMEASSEMBLER"
    config "tests/conf/phasing_dorado.config"
    tag "pipeline"
    tag "hic_phasing"

    test("Dorado outputs retain haplotype identity through scaffolding and export") {
        options "-stub-run"
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of('sampleA', 'sampleB', 'unphased').map { id ->
                    [meta: [
                        id: id, strategy: 'single', assembler_hifi: 'hifiasm',
                        hifiasm_hic_phasing: id != 'unphased', scaffold_hic: false,
                        scaffold_ragtag: true, scaffold: false, polish: 'dorado',
                        ontreads: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/ONT-Col-0_test_data.fastq.gz"),
                        ref_fasta: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/Col-CEN_v1.2.Chr1_5MB-7MB.fasta.gz"), use_ref: false,
                        hifireads: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/HiFi-Col-0_test_data.fastq.gz"),
                        phasing_reads: [f: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz"), r: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz")],
                        shortread_F: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/SRR22354810_1.sampled.fq.gz"),
                        shortread_R: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/SRR22354810_2.sampled.fq.gz"),
                        shortread_trim: true, paired: true, hic_trim: false,
                        qc_reads: 'hifi', jellyfish: false, meryl_k: 21,
                        quast: false, busco: false, merqury: true,
                        use_short_reads: true, lift_annotations: true,
                        ref_gff: file("https://raw.githubusercontent.com/nf-core/test-datasets/genomeassembler/A_thaliana_Col-0_2mb/Col-CEN_v1.2_genes_araport11.Chr1_5MB-7MB.gff3.gz")
                    ]]
                }
                """
            }
        }
        then {
            assert workflow.success
            def samples = workflow.out._assemblies.collect { it.meta }.sort { it.id }
            assert samples*.id == ['sampleA', 'sampleB', 'unphased']
            def prefixes = ['sampleA_hap1', 'sampleA_hap2', 'sampleB_hap1', 'sampleB_hap2', 'unphased']
            samples.findAll { it.id != 'unphased' }.each { meta ->
                assert meta.haplotypes.keySet() == ['hap1', 'hap2'] as Set
                ['hap1', 'hap2'].each { hap ->
                    def stages = meta.haplotype_results[hap]
                    assert stages.polished.keySet() == ['dorado'] as Set
                    assert path(stages.polished.dorado).getFileName().toString() == "${meta.id}_${hap}_dorado_polished.fa.gz"
                    assert path(stages.scaffolds.ragtag).getFileName().toString() == "${meta.id}_${hap}_ragtag.fa.gz"
                }
            }
            def unphased = samples.find { it.id == 'unphased' }
            assert path(unphased.polished.dorado).getFileName().toString() == 'unphased_dorado_polished.fa.gz'
            def rows = new File("$outputDir/genomeqc_samplesheet/nf-core-genomeqc-in.csv").readLines().drop(1)
            assert rows.size() == 15 && rows.toSet().size() == 15
            assert rows.every { new File(it.split(',')[1]).exists() }
            assert rows.findAll { it.split(',')[0].endsWith('-polish_dorado') }*.split(',')*.getAt(0).sort() == prefixes.collect { "${it}-polish_dorado".toString() }.sort()
            def alignments = []
            new File("$outputDir").eachFileRecurse { f -> if (f.name.endsWith('_dorado_aligned.bam')) alignments << f.name }
            assert alignments.sort() == prefixes.collect { "${it}_dorado_aligned.bam".toString() }.sort()
            prefixes.each { prefix ->
                def id = prefix.replaceFirst(/_hap[12]$/, '')
                assert new File("$outputDir/${id}/QC/merqury/${prefix}_dorado.qv").exists()
                assert new File("$outputDir/${id}/polish/dorado/${prefix}_dorado.gff3").exists()
                assert new File("$outputDir/${id}/polish/dorado/${prefix}_dorado.unmapped.txt").exists()
            }
            def doradoQv = []
            new File("$outputDir").eachFileRecurse { f -> if (f.name.endsWith('_dorado.qv')) doradoQv << f.name }
            assert doradoQv.sort() == prefixes.collectMany { ["${it}_dorado.qv".toString(), "${it}_dorado.${it}_dorado.qv".toString()] }.sort()
            assert snapshot(rows.collect { it.split(',')[0] }.sort()).match()
        }
    }
}
