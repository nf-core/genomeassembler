nextflow_workflow {
    name "Samplesheet-driven phased combined polishing"
    script "../tests/workflows/phasing_initialized.nf"
    workflow "PHASING_INITIALIZED"
    config "tests/conf/phasing_combined.config"
    tag "pipeline"
    tag "hic_phasing"

    test("Initialization permits ONT polishing followed by Pilon for both haplotypes") {
        options "-stub-run"
        when {
            params {
                outdir = "$outputDir"
                input = "https://raw.githubusercontent.com/nf-core/test-datasets/218acd6325ddcd1214e48951f3df5e3d0d2edc20/samplesheet/phasing/phasing_combined.csv"
                ref_gff = null
            }
            workflow {
                "input[0] = params.input"
            }
        }
        then {
            assert workflow.success
            def inputs = workflow.out.samples.collect { it.meta }.sort { it.id }
            assert inputs*.polish == ['dorado+pilon', 'medaka+pilon']
            assert inputs.every { it.assembler_hifi == 'hifiasm' && !it.assembler_ont && it.ontreads && it.phasing_reads }
            def samples = workflow.out._assemblies.collect { it.meta }.sort { it.id }
            assert samples.collect { [it.id, it.haplotype] }.sort { it.toString() } == [['dorado', 'hap1'], ['dorado', 'hap2'], ['medaka', 'hap1'], ['medaka', 'hap2']]
            samples.each { meta ->
                assert meta.polished.keySet() == ['pilon'] as Set
                assert path(meta.polished.pilon).getFileName().toString() == "${meta.id}_${meta.haplotype}_pilon.fa.gz"
                def ont_prefix = "${meta.id}_${meta.haplotype}_${meta.id}"
                def ont_outputs = new File("$outputDir/${meta.id}/polish/${meta.id}").listFiles()
                assert ont_outputs.any { it.name.startsWith(ont_prefix) && it.name.endsWith('.fa.gz') }
            }
            def rows = new File("$outputDir/genomeqc_samplesheet/nf-core-genomeqc-in.csv").readLines().drop(1)
            assert rows.size() == 8 && rows.toSet().size() == 8
            assert rows.every { new File(it.split(',')[1]).exists() }
            ['dorado', 'medaka'].each { tool ->
                ['hap1', 'hap2'].each { hap ->
                    assert rows.any { it.startsWith("${tool}_${hap}-polish_pilon,") }
                }
            }
            def expected_labels = ['dorado', 'medaka'].collectMany { tool ->
                ['hap1', 'hap2'].collectMany { hap ->
                    ['initial_assembly', 'polish_pilon'].collect { stage -> "${tool}_${hap}-${stage}".toString() }
                }
            }
            assert rows.collect { it.split(',')[0] }.sort() == expected_labels.sort()
        }
    }
}
