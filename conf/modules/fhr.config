process {
    withName: '.*FHR_EXPORT:(FAIRBIOHEADERS_.*|FHR_PREPARE_SEQUENCE|FHR_FINALIZE)' {
        cpus = 1
        // Size the export tasks from the decompressed FASTA when available.
        memory = {
            new nextflow.util.MemoryUnit(Math.max(6.GB.toBytes(), (meta.fhr_sequence_bytes ?: 0L) * 12L)) * task.attempt
        }
        time = '1 h'
        publishDir = []
        // Use the image shipped by the pinned modules for the local helpers too.
        container = {
            params.fhr_container ?: (workflow.containerEngine in ['singularity', 'apptainer'] && !task.ext.singularity_pull_docker_container
                ? 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/3a/3a69700529d3e088166672547fbd632315145414a75ee81a1686e1208038a937/data'
                : 'community.wave.seqera.io/library/fair-bioheaders:0.9.0--71029206d3ce1119')
        }
    }
    withName: '.*FHR_EXPORT:FHR_(PREPARE_SEQUENCE|FINALIZE)' {
        conda = "${projectDir}/modules/nf-core/fairbioheaders/combine/environment.yml"
    }
    withName: '.*FHR_EXPORT:FHR_WRITE_JSON' {
        publishDir = []
    }
    withName: '.*FHR_EXPORT:FHR_FINALIZE' {
        publishDir = [
            path: { "${params.outdir}/${meta.sample}/fhr/${meta.stage}" },
            mode: params.publish_dir_mode,
            pattern: '*.fhr.{fasta,yaml}'
        ]
    }
}
