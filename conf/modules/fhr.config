process {
    withLabel: fhr {
        cpus = 1
        // Converter uses whole-file objects. Allow 12x decompressed FASTA size,
        // with a 6 GB floor and increased allocation on each OOM retry.
        memory = {
            new nextflow.util.MemoryUnit(Math.max(6.GB.toBytes(), (meta.fhr_sequence_bytes ?: 0L) * 12L)) * task.attempt
        }
        time = '1 h'
        container = params.fhr_container
        conda = "${projectDir}/modules/local/fhr/environment.yml"
        // Intermediate metadata and decompressed files stay in the work directory.
        publishDir = []
    }
    withName: '.*FHR_EXPORT:FHR_WRITE_JSON' {
        publishDir = []
    }
    withName: '.*FHR_EXPORT:FHR_FINALIZE' {
        publishDir = [
            path: { "${params.outdir}/${meta.sample}/fhr/${meta.stage}" },
            mode: params.publish_dir_mode,
            pattern: '*.fhr.{fasta,yaml}'
        ]
    }
}
