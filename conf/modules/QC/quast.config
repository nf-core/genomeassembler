process {
    withName: '.*:ASSEMBLE:.*:QUAST' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_assembly"
        }
        ext.args = {
            [
                    '--glimmer',
                    '--large'
            ]
            .join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/QUAST" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*PILON:.*:QUAST' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_pilon"
        }
        ext.args = {
            [
                    '--glimmer',
                    '--large'
            ]
            .join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/QUAST" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*MEDAKA:.*:QUAST' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_medaka"
        }
        ext.args = {
            [
                    '--glimmer',
                    '--large'
            ]
            .join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/QUAST" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*DORADO:.*:QUAST' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_dorado"
        }
        ext.args = {
            [
                    '--glimmer',
                    '--large'
            ]
            .join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/QUAST" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*LINKS:.*:QUAST' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_links"
        }
        ext.args = {
            [
                    '--glimmer',
                    '--large'
            ]
            .join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/QUAST/" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*LONGSTITCH:.*:QUAST' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_longstitch"
        }
        ext.args = {
            [
                    '--glimmer',
                    '--large'
            ]
            .join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/QUAST/" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*SCAFFOLD:HIC.*:QUAST' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_yahs"
        }
        ext.args = {
            [
                    '--glimmer',
                    '--large'
            ]
            .join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/QUAST/" },
            mode: params.publish_dir_mode
        ]
    }
    // avoid catching ragtag from ont_on_hifi assembly
    withName: '.*:SCAFFOLD:.*RAGTAG:.*:QUAST' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_ragtag"
        }
        ext.args = {
            [
                    '--glimmer',
                    '--large'
            ]
            .join(" ")
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/QUAST/" },
            mode: params.publish_dir_mode
        ]
    }
}
