process {
    withName: '.*:ASSEMBLE:.*:MERQURY' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_assembly"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/merqury/" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*PILON:.*:MERQURY' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_pilon"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/merqury/" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*MEDAKA:.*:MERQURY' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_medaka"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/merqury/" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*LINKS:.*:MERQURY' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_links"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/merqury/" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*LONGSTITCH:.*:MERQURY' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_longstitch"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/merqury/" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*:SCAFFOLD:HIC:.*:MERQURY' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_yahs"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/merqury/" },
            mode: params.publish_dir_mode
        ]
    }
    // avoid catching ragtag from ont_on_hifi assembly
    withName: '.*:SCAFFOLD:.*RAGTAG:.*:MERQURY' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_ragtag"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/merqury/" },
            mode: params.publish_dir_mode
        ]
    }
}
