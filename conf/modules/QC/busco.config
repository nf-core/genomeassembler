process {
    withName: '.*:ASSEMBLE:.*:BUSCO' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_assembly-${lineage}"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/BUSCO/" },
            mode: params.publish_dir_mode,
            pattern: "*{-busco,_summary}*"
        ]
    }
    withName: '.*PILON:.*:BUSCO' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_pilon-${lineage}"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/BUSCO/" },
            mode: params.publish_dir_mode,
            pattern: "*{-busco,_summary}*"
        ]
    }
    withName: '.*MEDAKA:.*:BUSCO' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_medaka-${lineage}"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/BUSCO/" },
            mode: params.publish_dir_mode,
            pattern: "*{-busco,_summary}*"
        ]
    }
    withName: '.*DORADO:.*:BUSCO' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_dorado-${lineage}"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/BUSCO/" },
            mode: params.publish_dir_mode,
            pattern: "*{-busco,_summary}*"
        ]
    }
    withName: '.*LINKS:.*:BUSCO' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_links-${lineage}"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/BUSCO/" },
            mode: params.publish_dir_mode,
            pattern: "*{-busco,_summary}*"
        ]
    }
    withName: '.*LONGSTITCH:.*:BUSCO' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_longstitch-${lineage}"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/BUSCO/" },
            mode: params.publish_dir_mode,
            pattern: "*{-busco,_summary}*"
        ]
    }
    // avoid catching ragtag from ont_on_hifi assembly
    withName: '.*:SCAFFOLD:.*RAGTAG:.*:BUSCO' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_ragtag-${lineage}"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/BUSCO/" },
            mode: params.publish_dir_mode,
            pattern: "*{-busco,_summary}*"
        ]
    }
    withName: '.*:SCAFFOLD:.*HIC:QC.*:BUSCO' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_yahs-${lineage}"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/BUSCO/" },
            mode: params.publish_dir_mode,
            pattern: "*{-busco,_summary}*"
        ]
    }
}
