        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_assembly"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/alignments/" },
            mode: params.publish_dir_mode
        ]
        ext.args = {
            (meta.qc_reads == 'ont' ? "-ax lr:hq" : "-ax map-hifi")
        }
    }
    withName: '.*MEDAKA:.*MAP_TO_ASSEMBLY.*' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_medaka"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/alignments/" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*MEDAKA:.*MAP_TO_ASSEMBLY.*:ALIGN' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_medaka"
        }
        publishDir = [
