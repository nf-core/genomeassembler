process {
    // Refence
    withName: '.*MAP_TO_REF.*' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_to_reference"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/alignments/reference/" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*MAP_TO_REF.*:ALIGN' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_to_reference"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/alignments/reference/" },
            mode: params.publish_dir_mode
        ]
        ext.args = {
            (meta.qc_reads == 'ont' ? "-ax lr:hq" : "-ax map-hifi")
        }
    }
    // Assembly mappings
    withName: '.*ASSEMBLE:.*MAP_TO_ASSEMBLY.*' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_assembly"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/alignments/" },
            mode: params.publish_dir_mode
        ]
    }
