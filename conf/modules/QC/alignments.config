            mode: params.publish_dir_mode
        ]
        ext.args = {
            (meta.qc_reads == 'ont' ? "-ax lr:hq" : "-ax map-hifi")
        }
    }
    withName: '.*DORADO:.*MAP_TO_ASSEMBLY.*' {
