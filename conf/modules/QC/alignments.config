        ext.args = {
            (meta.qc_reads == 'ont' ? "-ax lr:hq" : "-ax map-hifi")
        }
    }
    withName: '.*SAMTOOLS:.*INDEX.*' {
        ext.args = {
            "-c -m ${params.csi_index_size}"
        }
    }
}
