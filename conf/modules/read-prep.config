process {
    withName: FASTP {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/reads/fastp" },
            mode: params.publish_dir_mode
        ]
    }

    withName: FASTP_HIC {
        ext.prefix = {"${meta.id}_hicreads"}
        publishDir = [
            path: { "${params.outdir}/${meta.id}/hic_reads/fastp" },
            mode: params.publish_dir_mode
        ]
    }
    
    withName: TO_FASTQ {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/reads/lima/fastq/" },
            mode: params.publish_dir_mode
        ]
    }

    withName: COLLECT {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/reads/collect" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:PREPARE_HIFI:FASTPLONG' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/reads/fastplong/hifi/" },
            mode: params.publish_dir_mode
        ]
        ext.args = {
            [
                meta.trimmer_hifi_args
            ].join(" ").trim()
        }
        ext.prefix = { "${meta.id}_hifi" }
    }
    
    withName: '.*:PREPARE_ONT:FASTPLONG' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/reads/fastplong/ont/" },
            mode: params.publish_dir_mode
        ]
        ext.args = {
            [
                meta.trimmer_ont_args
            ].join(" ").trim()
        }
        ext.prefix = { "${meta.id}_ont" }
    }

    withName: '.*:PREPARE_HIFI:CHOPPER' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/reads/chopper/hifi/" },
            mode: params.publish_dir_mode
        ]
        ext.args = {
            [
                meta.trimmer_hifi_args
            ].join(" ").trim()
        }
        ext.prefix = { "${meta.id}_hifi" }
    }
    
    withName: '.*:PREPARE_ONT:CHOPPER' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/reads/chopper/ont/" },
            mode: params.publish_dir_mode
        ]
        ext.args = {
            [
                meta.trimmer_ont_args
            ].join(" ").trim()
        }
        ext.prefix = { "${meta.id}_ont" }
    }
}
