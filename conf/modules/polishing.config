process {
    withName: MEDAKA {
        ext.args1 = { } // args mini_align
        ext.args2 = { [meta.medaka_model ? "--model ${meta.medaka_model}" : ''].join(" ").trim() } // args medaka_inference
        ext.args3 = {  } // args medaka sequence
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_medaka"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/polish/medaka" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
                filename == "${meta.id}${hap_suffix}_medaka.fa.gz" ? null : filename
            }
        ]
    }
    withName: '.*MEDAKA:BGZIP.*' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/polish/medaka" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.tokenize("/")[1]}
        ]
    }
    withName: '.*MEDAKA:UNZIP.*' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/polish/medaka" },
            mode: params.publish_dir_mode,
            saveAs: null
        ]
    }
    withName: '.*:POLISH_DORADO:ALIGN' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}"
        }
        //ext.args = { ["--add-fastq-rg"] }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/polish/dorado/alignment" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*:POLISH_DORADO:POLISH' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/polish/dorado/" },
            mode: params.publish_dir_mode
        ]
    }
    // Pilon mapping
    withName: '.*PILON:MAP_SR:ALIGN.*' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/alignments/shortreads/" },
            mode: params.publish_dir_mode
        ]
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_shortreads"
        }
        ext.args = { "-ax sr " }
    }
    withName: '.*PILON:MAP_SR.*' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/QC/alignments/shortreads/" },
            mode: params.publish_dir_mode
        ]
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_shortreads"
        }
    }
    withName: PILON {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_pilon"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/polish/pilon" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*:POLISH_PILON:BGZIP' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/polish/pilon" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.tokenize("/")[1]}
        ]
    }
}
