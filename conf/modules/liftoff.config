process {
    withName: '.*DORADO:.*LIFTOFF' {
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_dorado"
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/polish/dorado/" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*ASSEMBLE:.*LIFTOFF' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/assembly/" },
            mode: params.publish_dir_mode
        ]
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_assembly"
        }
    }
    withName: '.*PILON:.*LIFTOFF' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/polish/pilon/" },
            mode: params.publish_dir_mode
        ]
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_pilon"
        }
    }
    withName: '.*MEDAKA:.*LIFTOFF' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/polish/medaka" },
            mode: params.publish_dir_mode
        ]
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_medaka"
        }
    }
    withName: '.*RAGTAG:.*LIFTOFF' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/scaffold/ragtag/" },
            mode: params.publish_dir_mode
        ]
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_ragtag"
        }
    }
    withName: '.*LONGSTITCH:.*LIFTOFF' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/scaffold/longstitch" },
            mode: params.publish_dir_mode
        ]
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_longstitch"
        }
    }
    withName: '.*LINKS:.*LIFTOFF' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/scaffold/links" },
            mode: params.publish_dir_mode
        ]
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_links"
        }
    }
    withName: '.*HIC:.*LIFTOFF' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/scaffold/hic" },
            mode: params.publish_dir_mode
        ]
        ext.prefix = {
            def hap_suffix = meta.haplotype ? "_${meta.haplotype}" : ''
            "${meta.id}${hap_suffix}_links"
        }
    }
}
